{
  "functions": {
    "api/social.js": { "maxDuration": 300 },
    "api/shopify-video.js": { "maxDuration": 300 },
    "api/edu-video.py": { "maxDuration": 300 },
    "api/blogs.js": { "maxDuration": 300 },
    "api/dc-stock-sync.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/dc-stock-sync", "schedule": "0 6 * * *" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "seo-tools-lake.vercel.app"
        }
      ],
      "destination": "https://tools.aboutwallart.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
